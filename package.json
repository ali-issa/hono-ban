{
  "name": "hono-ban",
  "version": "1.0.0",
  "description": "Structured, extensible HTTP errors for Hono. One API, any wire format: RFC 9457 Problem Details, JSON:API, Google API (AIP-193), Stripe, or your own.",
  "keywords": [
    "aip-193",
    "boom",
    "error",
    "error-handling",
    "errors",
    "google-api",
    "hono",
    "http-errors",
    "json-api",
    "jsonapi",
    "middleware",
    "openapi",
    "problem-details",
    "rfc7807",
    "rfc9457",
    "stripe",
    "zod"
  ],
  "homepage": "https://github.com/ali-issa/hono-ban#readme",
  "bugs": "https://github.com/ali-issa/hono-ban/issues",
  "license": "MIT",
  "author": "Ali Issa (https://github.com/ali-issa)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ali-issa/hono-ban.git"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./formats/google-api": "./dist/formats/google-api.js",
    "./formats/json-api": "./dist/formats/json-api.js",
    "./formats/plain": "./dist/formats/plain.js",
    "./formats/problem-details": "./dist/formats/problem-details.js",
    "./formats/stripe": "./dist/formats/stripe.js",
    "./openapi": "./dist/openapi.js",
    "./otel": "./dist/otel.js",
    "./standard-schema": "./dist/standard-schema.js",
    "./testing": "./dist/testing.js",
    "./valibot": "./dist/valibot.js",
    "./zod": "./dist/zod.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "check": "pnpm run --sequential \"/^check:/\"",
    "check:deps": "knip",
    "check:format": "oxfmt --check",
    "check:lint": "oxlint",
    "check:pkg": "publint --strict && attw --pack . --profile esm-only",
    "check:types": "tsc --noEmit",
    "format": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepack": "pnpm run build",
    "prepare": "lefthook install",
    "release": "pnpm run build && changeset publish",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm run build && pnpm --filter hono-ban-e2e run typecheck && pnpm --filter hono-ban-e2e run test",
    "test:runtimes": "pnpm run build && pnpm --filter hono-ban-e2e run smoke:bun && pnpm --filter hono-ban-e2e run smoke:deno && pnpm --filter hono-ban-e2e run smoke:workerd",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.2",
    "@hono/standard-validator": "0.4.0",
    "@hono/valibot-validator": "0.6.1",
    "@hono/zod-openapi": "1.6.3",
    "@hono/zod-validator": "0.9.1",
    "@opentelemetry/api": "1.9.1",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "5.0.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "hono": "4.13.7",
    "knip": "6.34.0",
    "lefthook": "2.1.12",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "publint": "0.3.24",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "valibot": "1.4.2",
    "vitest": "5.0.0",
    "zod": "4.5.4"
  },
  "peerDependencies": {
    "hono": ">=4.12.34"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.3.4"
}
